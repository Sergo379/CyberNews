# Run scripts/init-env.ps1 to generate local credentials.
GATEWAY_PORT=8080
POSTGRES_PORT=5433
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_USER=cybernews_admin
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
COLLECTOR_DB_PASSWORD=
ARTICLE_DB_PASSWORD=
COMMUNITY_DB_PASSWORD=
MODERATION_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
RABBITMQ_USER=cybernews
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=cybernews
LOG_LEVEL=INFO
JWT_SECRET=
INTERNAL_AUTH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_SESSION_TTL_SECONDS=900
AUTH_SERVICE_URL=http://auth:8000

# Docker DNS names and internal HTTP ports used by the gateway.
AUTH_UPSTREAM=auth:8000
COLLECTOR_UPSTREAM=collector:8000
ARTICLES_UPSTREAM=articles:8000
COMMUNITY_UPSTREAM=community:8000
MODERATION_UPSTREAM=moderation:8000
NOTIFICATIONS_UPSTREAM=notifications:8000
