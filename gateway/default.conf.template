map $api_service $api_upstream {
    default        "";
    auth           ${AUTH_UPSTREAM};
    collector      ${COLLECTOR_UPSTREAM};
    articles       ${ARTICLES_UPSTREAM};
    community      ${COMMUNITY_UPSTREAM};
    moderation     ${MODERATION_UPSTREAM};
    notifications  ${NOTIFICATIONS_UPSTREAM};
}

map $http_x_request_id $gateway_request_id {
    default $request_id;
    "~^[a-zA-Z0-9._-]{1,128}$" $http_x_request_id;
}

log_format cybernews escape=json
    '{"timestamp":"$time_iso8601","service":"gateway","level":"info",'
    '"request_id":"$gateway_request_id","message":"HTTP request completed",'
    '"method":"$request_method","status":$status,"duration_seconds":$request_time}';

server {
    listen 8080;
    server_name _;
    default_type application/json;
    access_log /dev/stdout cybernews;
    resolver 127.0.0.11 valid=5s ipv6=off;

    location = / {
        return 200 '{"service":"gateway","status":"ok"}';
    }

    location = /health {
        return 200 '{"service":"gateway","status":"ok"}';
    }

    location ~ ^/api/v1/[^/]+/internal(?:/|$) {
        return 404 '{"detail":"Not Found"}';
    }

    location ~ ^/api/v1/(?<api_service>auth|collector|articles|community|moderation|notifications)/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $gateway_request_id;
        proxy_set_header X-Internal-Key "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;

        rewrite ^/api/v1/[^/]+(/.*)$ $1 break;
        proxy_pass http://$api_upstream;
    }

    location / {
        return 404 '{"detail":"Not Found"}';
    }
}
